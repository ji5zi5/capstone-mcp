from PIL.Image import Image
from collections.abc import Iterator

class Rectangle:
    left: int
    top: int
    right: int
    bottom: int

class ElementInfo:
    name: str
    control_type: str
    automation_id: str
    process_id: int
    runtime_id: list[int]

class ValuePattern:
    CurrentValue: str
    def SetValue(self, value: str) -> None: ...

class TogglePattern:
    CurrentToggleState: int
    def Toggle(self) -> None: ...

class SelectionPattern:
    def Select(self) -> None: ...

class UIAWrapper:
    handle: int
    element_info: ElementInfo
    iface_value: ValuePattern
    iface_toggle: TogglePattern
    iface_selection_item: SelectionPattern
    def children(self) -> list[UIAWrapper]: ...
    def iter_children(self) -> Iterator[UIAWrapper]: ...
    def descendants(self, *, control_type: str) -> list[UIAWrapper]: ...
    def rectangle(self) -> Rectangle: ...
    def process_id(self) -> int: ...
    def top_level_parent(self) -> UIAWrapper: ...
    def parent(self) -> UIAWrapper | None: ...
    def window_text(self) -> str: ...
    def is_enabled(self) -> bool: ...
    def is_visible(self) -> bool: ...
    def has_keyboard_focus(self) -> bool: ...
    def invoke(self) -> UIAWrapper: ...
    def expand(self) -> UIAWrapper: ...
    def collapse(self) -> UIAWrapper: ...
    def set_focus(self) -> UIAWrapper: ...
    def capture_as_image(self) -> Image: ...
    def click_input(self, *, button: str, coords: tuple[int, int], double: bool = False, absolute: bool = False) -> None: ...
    def drag_mouse_input(self, *, src: tuple[int, int], dst: tuple[int, int], absolute: bool) -> UIAWrapper: ...
    def release_mouse_input(self, *, coords: tuple[int, int], absolute: bool) -> UIAWrapper: ...
    def wheel_mouse_input(self, *, coords: tuple[int, int], wheel_dist: int) -> UIAWrapper: ...
    def type_keys(self, keys: str, *, with_spaces: bool, set_foreground: bool, pause: float = 0, vk_packet: bool = True) -> UIAWrapper: ...
